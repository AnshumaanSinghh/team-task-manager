# Nothing is required for local development: "/api" is proxied to
# http://localhost:5000 by vite.config.js.

# Point the dev proxy somewhere else (optional)
# API_PROXY_TARGET=http://localhost:5000

# Call an API on a different origin directly instead of "/api" (optional).
# Leave unset on Vercel: vercel.json rewrites /api to the backend.
# VITE_API_URL=https://your-api.example.com/api
