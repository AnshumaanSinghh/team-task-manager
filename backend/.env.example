# Copy to backend/.env for local development. Never commit the real .env.
# Locally everything is optional: without MONGO_URI the API uses
# mongodb://127.0.0.1:27017/taskflow, and a development JWT secret is generated.
PORT=5000
# MONGO_URI (or MONGODB_URI, as set by the Vercel Marketplace Atlas integration)
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskflow?retryWrites=true&w=majority
# JWT_SECRET=paste-the-output-of-openssl-rand-hex-32
NODE_ENV=development

# Optional: comma-separated list of allowed frontend origins (default: allow all)
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Optional AI providers for Quick Add and the AI Planner. Without any key the
# built-in parser and planning templates are used.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
